# Intervals.icu credentials (Settings -> Developer Settings)
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=0
# INTERVALS_BASE_URL=https://intervals.icu/api/v1

# LLM provider (default: OVHcloud AI Endpoints anonymous free tier - NO API key required)
# The anonymous tier is IP-rate-limited (~2 requests/minute) and is enough for
# personal use. OVH_API_KEY is optional and only needed for the paid tier.
# OVH_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# OVH_API_KEY=
LLM_PROVIDER=ovh
# Optional model override; when omitted each provider uses its own default
# (ovh -> Qwen3.5-397B-A17B, deepseek -> deepseek-v4-pro).
# LLM_MODEL=Qwen3.5-397B-A17B
LLM_THINKING=true
# LLM_REASONING_EFFORT=high
# LLM_MAX_TOKENS=8192
# LLM_TIMEOUT_SECONDS=180
# LLM_TEMPERATURE=null

# DeepSeek (optional alternative; REQUIRES the key below or selecting it fails)
# Switch per run with: coach chat --provider deepseek (-p deepseek)
# Or inside the chat with: /provider deepseek
# Or set LLM_PROVIDER=deepseek here.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# App settings
# Must match the athlete's Intervals.icu account timezone: training-day boundaries
# and calendar dates are written as midnight in this zone.
APP_TIMEZONE=Europe/Paris
# DATABASE_PATH=data/coach.db
# HTTP_PORT=8000

# HTTP retry/rate-limit knobs
# REQUESTS_PER_SECOND=8
# MAX_RETRIES=3
# RETRY_BASE_DELAY=1

# Coach personalization
# ATHLETE_PROFILE=
# COACH_TONE=Be objective, strict, and analytical. Do not offer generic encouragement.

# Chat history (multi-turn memory, seeded from the feedback table; values must be >= 1)
# CHAT_HISTORY_TURNS=10
# CHAT_HISTORY_MAX_TOKENS=2048
# CHAT_HISTORY_MAX_AGE_DAYS=90
