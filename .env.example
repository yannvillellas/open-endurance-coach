# Intervals.icu credentials (Settings -> Developer Settings)
INTERVALS_API_KEY=
INTERVALS_ATHLETE_ID=0
# INTERVALS_BASE_URL=https://intervals.icu/api/v1

# LLM provider (default: OVHcloud AI Endpoints anonymous free tier - NO API key required)
# The anonymous tier is IP-rate-limited (~2 requests/minute) and is enough for
# personal use. OVH_API_KEY is optional and only needed for the paid tier.
# OVH_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# OVH_API_KEY=
LLM_PROVIDER=ovh
# Optional model override; when omitted each provider uses its own default
# (ovh -> Qwen3.5-397B-A17B, deepseek -> deepseek-flash).
# LLM_MODEL=Qwen3.5-397B-A17B
LLM_THINKING=true
# LLM_REASONING_EFFORT=high
# Output budget shared by reasoning and the analysis JSON. Reasoning models count
# their reasoning against it; measured 2026-09-15 OVH used ~7k tokens on a modest
# prompt, so keep generous headroom.
# LLM_MAX_TOKENS=32768
# Optional lower cap on the whole request input budget (system prompt + athlete data +
# conversation history). Unset uses the active model's usable window: its context window
# minus the reply reserve and a 20% safety margin (OVH ~176948, DeepSeek ~806093).
# LLM_INPUT_BUDGET=
# Override the model's published limits. Only needed for a model the app does not know:
# an unknown model without LLM_CONTEXT_WINDOW is rejected.
# LLM_CONTEXT_WINDOW=
# LLM_MAX_OUTPUT_TOKENS=
# LLM_TIMEOUT_SECONDS=180
# LLM_TEMPERATURE=null

# DeepSeek (optional alternative; REQUIRES the key below or selecting it fails)
# Switch per run with: coach -p deepseek
# Or inside the chat with: /provider deepseek
# Or set LLM_PROVIDER=deepseek here.
# DeepSeek model: deepseek-flash (V4.1 Flash, default).
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# App settings
# Must match the athlete's Intervals.icu account timezone: training-day boundaries
# and calendar dates are written as midnight in this zone.
APP_TIMEZONE=Europe/Paris
# DATABASE_PATH=data/coach.db

# HTTP retry/rate-limit knobs
# REQUESTS_PER_SECOND=8
# MAX_RETRIES=3
# RETRY_BASE_DELAY=1

# Coach personalization
# ATHLETE_PROFILE=
# COACH_TONE=Be objective, strict, and analytical. Do not offer generic encouragement.

# Chat history (multi-turn memory, seeded from the messages log; values must be >= 1).
# The in-session cap is derived from the model's input budget, not configured here.
# Messages older than this are pruned at startup.
# CHAT_HISTORY_TURNS=10
# CHAT_HISTORY_MAX_AGE_DAYS=90
